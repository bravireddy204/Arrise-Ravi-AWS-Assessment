# Replace these three IDs with resources in Account A.
fleet = {
  ami_id             = "ami-0123456789abcdef0"
  subnet_id          = "subnet-0123456789abcdef0"
  security_group_ids = ["sg-0123456789abcdef0"]
  environment        = "assessment"
  owner              = "Ravi"

  # Each key_name is an existing EC2 key pair in the chosen region.
  instances = {
    web = {
      instance_type = "t3.micro"
      root_type     = "gp3"
      root_gib      = 20
      key_name      = "web-key"
    }
    worker = {
      instance_type = "t3.small"
      root_type     = "gp2"
      root_gib      = 24
      key_name      = "worker-key"
    }
    reports = {
      instance_type = "m5.large"
      root_type     = "io1"
      root_gib      = 32
      key_name      = "reports-key"
      iops          = 1000
    }
    ledger = {
      instance_type = "m5.xlarge"
      root_type     = "io2"
      root_gib      = 48
      key_name      = "ledger-key"
      iops          = 2000
    }
    sandbox = {
      instance_type = "t3.medium"
      root_type     = "standard"
      root_gib      = 16
      key_name      = "sandbox-key"
    }
  }
}

