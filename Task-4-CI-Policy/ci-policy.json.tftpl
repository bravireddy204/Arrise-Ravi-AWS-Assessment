{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SignInToEcrInTheDeploymentRegion",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "${region}" }
      }
    },
    {
      "Sid": "PushImagesToRaviApp",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:${region}:${account_id}:repository/ravi-app"
    },
    {
      "Sid": "RegisterRaviAppRevisions",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:${region}:${account_id}:task-definition/ravi-app:*"
    },
    {
      "Sid": "DeployRaviAppToWeb",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": "arn:aws:ecs:${region}:${account_id}:service/assessment/web",
      "Condition": {
        "ArnLike": {
          "ecs:task-definition": "arn:aws:ecs:${region}:${account_id}:task-definition/ravi-app:*"
        }
      }
    },
    {
      "Sid": "CheckWebDeployment",
      "Effect": "Allow",
      "Action": "ecs:DescribeServices",
      "Resource": "arn:aws:ecs:${region}:${account_id}:service/assessment/web"
    },
    {
      "Sid": "PassOnlyTheExecutionRoleToEcsTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/ravi-app-execution",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    },
    {
      "Sid": "ListBuildArtifacts",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ravi-${account_id}-build-artifacts",
      "Condition": {
        "StringEquals": { "s3:ResourceAccount": "${account_id}" }
      }
    },
    {
      "Sid": "DownloadBuildArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ravi-${account_id}-build-artifacts/*",
      "Condition": {
        "StringEquals": { "s3:ResourceAccount": "${account_id}" }
      }
    }
  ]
}
